generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  ADMIN
  ORGANIZER
  PHOTOGRAPHER
}
enum EventRole {
  ORGANIZER
  PHOTOGRAPHER
}
enum PhotoStatus {
  UPLOADING
  PROCESSING
  PENDING
  PUBLISHED
  HIDDEN
  FAILED
  DELETING
}
enum JobKind {
  THUMBNAIL
  ZIP
  DELETE_MEDIA
  EXPIRE_EVENT
}
enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         UserRole      @default(ORGANIZER)
  disabledAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownedEvents  Event[]
  memberships  EventMember[]
  sessions     Session[]
  passwordReset PasswordResetToken?
  photos       Photo[]
}
model Event {
  id                  String        @id @default(cuid())
  ownerId             String
  owner               User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title               String
  slug                String        @unique
  code                String        @unique
  description         String        @default("")
  startsAt            DateTime?
  expiresAt           DateTime?
  deletedAt           DateTime?
  passwordHash        String?
  accessVersion       Int           @default(1)
  mediaVersion        Int           @default(1)
  allowGuestUploads   Boolean       @default(false)
  // Compatibility field; accepted guest uploads are always published.
  moderateUploads     Boolean       @default(false)
  allowDownloads      Boolean       @default(true)
  maxPhotos           Int           @default(1000)
  maxStorageBytes     BigInt        @default(10737418240)
  maxUploadBytes      Int           @default(26214400)
  usedStorageBytes    BigInt        @default(0)
  reservedBytes       BigInt        @default(0)
  viewCount           BigInt        @default(0)
  downloadCount       BigInt        @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  members             EventMember[]
  photos              Photo[]
  accessTokens        AccessToken[]
  albumViews          AlbumView[]
  jobs                MediaJob[]
  @@index([ownerId, createdAt])
  @@index([expiresAt])
}
model EventMember {
  eventId String
  userId  String
  role    EventRole
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([eventId, userId])
  @@index([userId])
}
model Photo {
  id              String      @id @default(cuid())
  eventId         String
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  uploaderId      String?
  uploader        User?       @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  originalKey     String      @unique
  thumbnailKey    String?     @unique
  filename        String
  mimeType        String
  sizeBytes       BigInt
  thumbnailBytes  BigInt      @default(0)
  reservedBytes   BigInt      @default(0)
  width           Int?
  height          Int?
  status          PhotoStatus @default(UPLOADING)
  uploadExpiresAt DateTime?
  downloadCount   BigInt      @default(0)
  likes           PhotoLike[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@index([eventId, status, createdAt, id])
  @@index([status, uploadExpiresAt])
}
model PhotoLike {
  photoId   String
  voterHash String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([photoId, voterHash])
}
// Only retained for the rolling deduplication window; Event.viewCount is cumulative.
model AlbumView {
  eventId       String
  visitorHash   String
  lastCountedAt DateTime @default(now()) @db.Timestamptz(3)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@id([eventId, visitorHash])
  @@index([lastCountedAt])
}
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model AccessToken {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accessVersion Int
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  @@index([eventId])
  @@index([expiresAt])
}
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model MediaJob {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  kind        JobKind
  status      JobStatus @default(QUEUED)
  dedupeKey   String    @unique
  payload     Json
  resultKey   String?
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedUntil DateTime?
  lockToken   String?
  expiresAt   DateTime?
  totalPhotos Int       @default(0)
  processedPhotos Int   @default(0)
  sizeBytes   BigInt    @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([status, availableAt])
  @@index([kind, expiresAt])
}

// Fixed-window counters are shared by all application processes.
model AuthRateLimit {
  key      String   @id
  attempts Int      @default(0)
  resetAt  DateTime @db.Timestamptz(3)
  @@index([resetAt])
}
