# Local defaults only. Replace all passwords before production.
APP_URL=http://localhost:3000
POSTGRES_USER=partyphoto
POSTGRES_PASSWORD=local-change-me
POSTGRES_DB=partyphoto
DATABASE_URL=postgresql://partyphoto:local-change-me@localhost:5432/partyphoto?schema=public
# Local authenticated SeaweedFS (rootless script or Docker), private bucket.
# Credentials are server-only; never use NEXT_PUBLIC_* for these variables.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=partyphoto
S3_ACCESS_KEY_ID=partyphoto-local
S3_SECRET_ACCESS_KEY=local-storage-change-me
# For R2/S3 production: keep the bucket private; scope keys to this bucket.
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400
# ZIP: maximum original bytes and photo count; archives expire 1 hour after queuing.
MAX_ZIP_BYTES=1073741824
MAX_ZIP_PHOTOS=10000
# Production: https://photos.example.com, managed R2/S3 endpoint and scoped credentials.
# Free course demo: see docs/free-demo.md and render.yaml. Default local behavior is unchanged.
# PARTYPHOTO_DEMO_MODE=true caps photos at 3 MiB / 6 MP and reduces processing concurrency.
# Use a separate .env.demo for remote Supabase; never replace this local DB accidentally.
